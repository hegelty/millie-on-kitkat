# Only reviewed public deliverables are eligible for tracking.
/*
!/.gitignore
!/README.md
!/patches.json
!/docs/
!/revanced/
/docs/*
!/docs/PATCH-DESIGN.md
/revanced/*
!/revanced/.gitignore
!/revanced/README.md
!/revanced/VERIFICATION.md
!/revanced/build.py
!/revanced/make_delta.py
!/revanced/verify_apk.py
!/revanced/tools.lock.json
!/revanced/src/
!/revanced/runtime/
!/revanced/payloads/
!/revanced/licenses/
!/revanced/dist/
/revanced/dist/*
!/revanced/dist/millie-eink-patches-0.1.0.rvp
!/revanced/dist/SHA256SUMS

# APKs, signing credentials and local build output are never distributed.
*.apk
*.apks
*.aab
*.xapk
*.idsig
*.keystore
*.jks
*.bks
*.p12
*.pfx
*.key
*.pem
.env
.env.*
__pycache__/
*.pyc
